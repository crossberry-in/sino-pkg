def cmd_install(args):
    """Install dependencies from mozhi.toml."""
    manifest = Manifest.load(MANIFEST_FILE)
    deps = manifest.dependencies
    if not deps:
        info("No dependencies to install.")
        return

    ui.write(ui.bold(f"Installing {len(deps)} dependencies..."))
    ui.write()

    lock = load_lock() or {"packages": {}}
    lock_packages = lock.get("packages", {})

    deps_dir = Path("mozhi_modules")
    deps_dir.mkdir(exist_ok=True)

    for dep_name, version_req in deps.items():
        ui.info(f"Resolving {dep_name} ({version_req})...")
        try:
            version, source_path = resolve_dependency(dep_name, version_req)
            ui.success(f"{dep_name} -> v{version}", f"Source: {source_path}")

            link_path = deps_dir / dep_name.replace(":", "_").replace("/", "_")
            if link_path.exists() or link_path.is_symlink():
                link_path.unlink()
            os.symlink(source_path, link_path)

            lock_packages[dep_name] = {
                "version": str(version),
                "source": str(source_path),
                "resolved_at": datetime.now().astimezone().isoformat(),
            }
        except Exception as e:
            error(f"Failed to resolve {dep_name}: {e}")

    lock["packages"] = lock_packages
    save_lock(lock)
    ui.write()
    ui.success(f"Installed {len(lock_packages)} dependencies.",
               f"Lock file: {LOCK_FILE}")

def cmd_add(args):
    """Add a dependency."""
    if not args:
        die("Usage: sino add <source> [version]\n"
            "  sino add github:owner/repo\n"
            "  sino add github:owner/repo@1.2.0\n"
            "  sino add local:../mylib\n"
            "  sino add mylib 1.0.0")

    source = args[0]
    version = args[1] if len(args) > 1 else "*"

    manifest = Manifest.load(MANIFEST_FILE)

    if source.startswith("github:"):
        parts = source[len("github:"):]
        if "@" in parts:
            repo, _, tag = parts.partition("@")
            dep_key = f"github:{repo}"
            version = tag
        else:
            dep_key = source
        manifest.dependencies[dep_key] = version
    elif source.startswith("local:"):
        manifest.dependencies[source] = version
    else:
        manifest.dependencies[source] = version

    manifest.save(MANIFEST_FILE)
    ok(f"Added dependency: {source} ({version})")
    info("Run 'sino install' to install it.")

