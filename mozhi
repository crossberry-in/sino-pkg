    for si in src_dir.glob("*.si"):
        # Simple linter: check for unused vars, missing end, etc.
        text = si.read_text()
        lines = text.splitlines()
        for i, line in enumerate(lines, 1):
            stripped = line.strip()
            if stripped.startswith("var ") and "=" in stripped:
                var_name = stripped.split()[1]
                # Check if used elsewhere (very basic)
                uses = sum(1 for l in lines if var_name in l) - 1
                if uses == 0:
                    warnings_count += 1
                    ui.diagnostic(
                        severity="warning", code="SN2001",
                        title="Unused variable",
                        file=str(si), line=i, col=5,
                        source_line=stripped, col_span=len(var_name),
                        message=f"Variable '{var_name}' is never used.",
                        suggestion="Remove the variable."
                    )
    ui.write()
    ui.success("Lint completed.",
               f"{errors} errors\n{warnings_count} warnings")
    ui.write()
    if errors == 0 and warnings_count == 0:
        ui.write(f"Build quality: {'Excellent'}")
    elif errors == 0:
