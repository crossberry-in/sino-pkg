LOCK_VERSION = 1

def load_lock():
    p = Path(LOCK_FILE)
    if not p.exists():
        return None
    try:
        return json.loads(p.read_text())
    except json.JSONDecodeError:
        warn(f"Corrupted {LOCK_FILE}, ignoring.")
        return None

def save_lock(lock_data):
    lock_data["version"] = LOCK_VERSION
    lock_data["updated"] = datetime.now().astimezone().isoformat()
    Path(LOCK_FILE).write_text(json.dumps(lock_data, indent=2, sort_keys=True))

