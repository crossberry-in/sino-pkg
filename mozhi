def cmd_init(args):
    """Initialize a new Sino project."""
    project_type = "lib"
    name = None
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--lib", "--library"):
            project_type = "lib"
        elif a in ("--bin", "--binary", "--app"):
            project_type = "bin"
        elif a.startswith("--"):
            warn(f"Unknown option: {a}")
        else:
            name = a
        i += 1

    if not name:
        name = Path.cwd().name
        if name in ("src", "build", "dist", ""):
            die("Please provide a project name: sino init --lib mylib")
        info(f"Using current directory name: {name}")

    project_dir = Path(name) if name != Path.cwd().name else Path(".")
    if project_dir != Path("."):
