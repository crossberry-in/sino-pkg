def find_mozhi_interpreter():
    """Find the Sino interpreter binary, excluding this script itself.

    Order of lookup:
      1. $MOZHI_INTERPRETER env var
      2. ~/.sino/bin/mozhi-interpreter (or mozhi-interpreter.exe on Windows)
      3. 'mozhi-interpreter' on PATH
      4. 'mozhi' on PATH, but only if it's NOT the mozhi-pkg Python script
      5. None
    """
    is_windows = SYSTEM == "windows"
    exe_suffix = ".exe" if is_windows else ""

    # 1. Env var
    env_path = os.environ.get("MOZHI_INTERPRETER")
    if env_path and Path(env_path).exists():
        return env_path

    # 2. ~/.sino/bin/mozhi-interpreter
    interp = MOZHI_HOME / "bin" / f"mozhi-interpreter{exe_suffix}"
    if interp.exists():
        return str(interp)

    # 3. mozhi-interpreter on PATH
    interp = shutil.which("mozhi-interpreter")
    if interp:
        return interp

    # 4. sino on PATH, but skip if it's our own script
    self_path = str(Path(__file__).resolve())
    path = shutil.which("mozhi")
    if path:
        path = str(Path(path).resolve())
        if path != self_path:
            # Check if it's a Python script (mozhi-pkg) vs a binary (interpreter)
            try:
                with open(path, "rb") as f:
                    first = f.read(2)
                if first != b"#!":
                    # It's a binary — the interpreter!
                    return path
            except Exception:
                pass

    return None

