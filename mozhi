def extract_functions(si_file):
    """Extract public function definitions from a .si file."""
    funcs = []
    lines = si_file.read_text().splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        comment = ""
        while i < len(lines) and lines[i].strip().startswith("#"):
            comment += lines[i].strip().lstrip("#").strip() + " "
            i += 1
        if i >= len(lines):
            break
        line = lines[i].strip()
        m = re.match(r"(?:public\s+)?func\s+(\w+)\s*\(([^)]*)\)", line)
        if m:
            name = m.group(1)
            params = [p.strip() for p in m.group(2).split(",") if p.strip()]
            is_public = line.startswith("public")
            if is_public or True:
                funcs.append({"name": name, "params": params, "comment": comment.strip()})
        i += 1
    return funcs

