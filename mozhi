def main():
    """Unified Sino command dispatcher.

    Routing rules (Go-style unified CLI):
      - `sino` (no args)                     → start REPL (via interpreter)
      - `sino file.si`                       → run file (via interpreter)
      - `sino -` or `sino --`                → interpreter (stdin mode)
      - `sino -v / --version / -V`           → mozhi-pkg version
      - `sino -h / --help`                   → mozhi-pkg help
      - `sino <subcommand> [args]`           → mozhi-pkg subcommand
      - `sino <unknown-word>`                → try as filename via interpreter
                                                 (preserves backwards compat)
    """
    global ui

    # No args → start the REPL via the interpreter
    if len(sys.argv) < 2:
        cmd_repl([])
        return

    cmd = sys.argv[1]
    args = sys.argv[2:]

    # Flags that should show mozhi-pkg's version/help
    if cmd in ("-v", "--version", "-V"):
        ui = create_ui()
        cmd_version([])
        return
    if cmd in ("-h", "--help"):
        ui = create_ui()
        cmd_help([])
        return

    # If the first arg is a .si file, run it via the interpreter
    if cmd.endswith(".si"):
        ui = create_ui()
        interp = find_mozhi_interpreter()
        if not interp:
            die("Sino interpreter not found. Install it from "
                "https://github.com/crossberry-in/mozhi-doc/releases "
                "or set $MOZHI_INTERPRETER.")
        os.execvp(interp, [interp, cmd] + args)

    # If the first arg is a known subcommand, dispatch to mozhi-pkg
    if cmd in COMMANDS:
        ui = ui_from_args(args)
        MOZHI_HOME.mkdir(parents=True, exist_ok=True)
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        COMMANDS[cmd](args)
        return

    # Otherwise, treat the first arg as a filename and pass to the interpreter.
    # This preserves backwards compatibility: `sino myscript` still works
    # if `myscript` is a file (the interpreter will error if it's not).
    ui = create_ui()
    interp = find_mozhi_interpreter()
    if interp:
        os.execvp(interp, [interp] + sys.argv[1:])
    else:
        ui.fail(f"Unknown command or file: {cmd}")
        ui.write()
        ui.info("Run 'sino help' for usage.")
        sys.exit(1)

if __name__ == "__main__":
    main()
