# Dependency Resolution
# ============================================================================

def resolve_dependency(name, version_req):
    """Resolve a dependency to a concrete version and source path.
    Returns (version_string, source_path) or raises.
    """
    if name.startswith("github:"):
        return resolve_github_dependency(name, version_req)
    if name.startswith("local:"):
        return resolve_local_dependency(name, version_req)
    return resolve_registry_dependency(name, version_req)

def resolve_github_dependency(name, version_req):
    """Clone a GitHub repo, find a matching version tag, cache it."""
    parts = name[len("github:"):]
    if "@" in parts:
        repo, _, tag = parts.partition("@")
    else:
        repo, tag = parts, None

    cache_key = f"{repo}@{tag or version_req}"
    cache_path = CACHE_DIR / "github" / repo.replace("/", "_")
    if tag:
        cache_path = cache_path.parent / f"{cache_path.name}@{tag}"

    if cache_path.exists():
        info(f"Using cached {name}")
        manifest = Manifest.load(cache_path / MANIFEST_FILE)
        return manifest.version, cache_path

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    cache_path.parent.mkdir(parents=True, exist_ok=True)

    url = f"https://github.com/{repo}.git"
    if tag:
        if not tag[0].isdigit() and not tag.startswith("v"):
            tag_to_use = tag
        else:
            tag_to_use = tag
        info(f"Cloning {url} @ {tag_to_use}...")
        result = subprocess.run(
            ["git", "clone", "--depth", "1", "--branch", tag_to_use, url, str(cache_path)],
            capture_output=True, text=True
        )
        if result.returncode != 0:
            die(f"git clone failed: {result.stderr.strip()}")
    else:
        info(f"Cloning {url}...")
        result = subprocess.run(
            ["git", "clone", "--depth", "1", url, str(cache_path)],
            capture_output=True, text=True
        )
        if result.returncode != 0:
            die(f"git clone failed: {result.stderr.strip()}")

    if not (cache_path / MANIFEST_FILE).exists():
        die(f"Repository {repo} does not contain {MANIFEST_FILE}")

    manifest = Manifest.load(cache_path / MANIFEST_FILE)
    return manifest.version, cache_path

def resolve_local_dependency(name, version_req):
    """Resolve a local path dependency."""
    path = name[len("local:"):]
    p = Path(path).resolve()
    if not p.exists():
        die(f"Local dependency path does not exist: {p}")
    if not (p / MANIFEST_FILE).exists():
        die(f"Local dependency {p} has no {MANIFEST_FILE}")
    manifest = Manifest.load(p / MANIFEST_FILE)
    return manifest.version, p

def resolve_registry_dependency(name, version_req):
    """Resolve a dependency from the local registry cache."""
    reg_path = REGISTRY_DIR / name
    if not reg_path.exists():
        die(f"Dependency '{name}' not found in registry. "
            f"Use 'sino add github:owner/{name}' or 'sino add local:path/{name}'.")
    versions = []
    for d in reg_path.iterdir():
        if d.is_dir():
            try:
                v = SemVer.parse(d.name)
                versions.append((v, d))
            except ValueError:
                continue
    if not versions:
        die(f"No versions of '{name}' in registry cache.")
    versions.sort(key=lambda x: x[0])
    req_fn = parse_version_req(version_req)
    for v, d in reversed(versions):
        if req_fn(v):
            return str(v), d
    die(f"No version of '{name}' satisfies '{version_req}'.")

