class Manifest:
    """Represents a mozhi.toml manifest file."""

    def __init__(self, data):
        self.data = data
        self.name = data.get("name", "")
        self.version = data.get("version", "0.1.0")
        self.authors = data.get("authors", [])
        self.license = data.get("license", "")
        self.description = data.get("description", "")
        self.dependencies = data.get("dependencies", {})
        self.build = data.get("build", {})
        self.build_output = self.build.get("output", {})
        self.output_type = self.build_output.get("type", "static")

    @classmethod
    def load(cls, path):
        p = Path(path)
        if not p.exists():
            die(f"No {MANIFEST_FILE} found in current directory. Run 'sino init' first.")
        text = p.read_text()
        return cls(parse_toml(text))

    def save(self, path):
        Path(path).write_text(dump_toml(self.data))

    def build_config(self):
        return {
            "c": self.build.get("c", False),
            "cpp": self.build.get("cpp", False),
            "assembly": self.build.get("assembly", False),
            "rust": self.build.get("rust", False),
        }

