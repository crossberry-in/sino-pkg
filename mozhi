                      "regex", "datetime", "math", "vector", "matrix"]
    results = [p for p in known_packages if query.lower() in p.lower()]
    if not results:
        ui.write(ui.dim("  No packages found."))
    else:
        for p in results:
            ui.write(f"  {p}")
    ui.write()
    ui.info("Use 'sino add <name>' to add a package.")

def cmd_uninstall(args):
    """Uninstall a package."""
    if not args:
        die("Usage: sino uninstall <name>")
    name = args[0]
    manifest = Manifest.load(MANIFEST_FILE)
    if name in manifest.dependencies:
        del manifest.dependencies[name]
        manifest.save(MANIFEST_FILE)
        ui.success(f"Uninstalled: {name}")
    else:
        # Also remove from mozhi_modules
        link = Path("mozhi_modules") / name.replace(":", "_").replace("/", "_")
        if link.exists() or link.is_symlink():
            if link.is_symlink() or link.is_file():
                link.unlink()
            else:
                shutil.rmtree(link)
            ui.success(f"Uninstalled: {name}")
        else:
            die(f"Package '{name}' is not installed.")

def cmd_login(args):
    """Log in to the registry."""
    ui.info("Logging in to the Sino registry...")
    ui.write()
    username = input("Username: ").strip()
    if not username:
        die("Username is required.")
    # Read password without echo
    import getpass
    password = getpass.getpass("Password: ")
    if not password:
        die("Password is required.")
    # Save credentials (in real impl, this would be a token)
    creds_file = MOZHI_HOME / "credentials.json"
    MOZHI_HOME.mkdir(parents=True, exist_ok=True)
    creds_file.write_text(json.dumps({
        "username": username,
        "token": "stub-token-" + hashlib.sha256(password.encode()).hexdigest()[:16],
    }, indent=2))
    ui.write()
    ui.success(f"Logged in as {username}.")

def cmd_logout(args):
    """Log out of the registry."""
    creds_file = MOZHI_HOME / "credentials.json"
    if creds_file.exists():
        creds_file.unlink()
        ui.success("Logged out.")
    else:
        ui.info("Not logged in.")

def cmd_doctor(args):
    """Check the Sino environment."""
    ui.banner(title="Mozhi Environment Check", subtitle=f"v{VERSION}",
              tagline="Diagnosing your setup...")
    ui.write()

    checks = []

    # Compiler
    sino_bin = find_mozhi_interpreter()
    if sino_bin:
        checks.append(("Compiler", "OK", f"found at {sino_bin}"))
    else:
        checks.append(("Compiler", "FAIL", "sino interpreter not found — install from mozhi-doc releases"))

    # Package manager
    checks.append(("Package Manager", "OK", f"mozhi-pkg v{VERSION}"))

    # Runtime
    py_version = f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}"
    if sys.version_info >= (3, 8):
        checks.append(("Runtime", "OK", f"Python {py_version}"))
    else:
        checks.append(("Runtime", "FAIL", f"Python {py_version} (need 3.8+)"))

    # Libraries (compilers)
    compilers = detect_compilers()
    missing = [k for k in ["c", "cpp", "ar"] if k not in compilers]
    if not missing:
        checks.append(("Libraries", "OK", f"C={Path(compilers['c']).name}, C++={Path(compilers['cpp']).name}"))
    else:
        checks.append(("Libraries", "WARN", f"missing: {', '.join(missing)}"))

    # Network (try to reach github.com)
    try:
        urllib.request.urlopen("https://github.com", timeout=3)
        checks.append(("Network", "OK", "github.com reachable"))
    except Exception as e:
        checks.append(("Network", "WARN", f"cannot reach github.com: {e}"))

    # Render
    for name, status, detail in checks:
        if status == "OK":
            sym = ui.symbol("ok")
            ui.write(f"  {sym} {name.ljust(20)} {ui.dim(detail)}")
        elif status == "WARN":
            sym = ui.symbol("warn")
            ui.write(f"  {sym} {name.ljust(20)} {ui.dim(detail)}")
        else:
            sym = ui.symbol("fail")
            ui.write(f"  {sym} {name.ljust(20)} {ui.dim(detail)}")
    ui.write()

    has_fail = any(s == "FAIL" for _, s, _ in checks)
    if has_fail:
        ui.warning("Some checks failed.", "See https://github.com/crossberry-in/mozhi-doc for install instructions.")
    else:
        ui.success("Everything looks good.")

