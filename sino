#!/usr/bin/env python3
"""
Sino Package Manager (sino-pkg) v1.0.0

A production-ready package manager for the Sino programming language.
Supports native Sino libraries, C/C++/Assembly/Rust FFI, static/shared
library output, GitHub-hosted dependencies, semantic versioning, lock
files, testing, and documentation generation.

Usage:
    sino <command> [options] [args]

Commands:
    init       Initialize a new Sino project (--lib or --bin)
    build      Build the project (static/shared/native output)
    install    Install dependencies from sino.toml
    add        Add a dependency (github:owner/repo, local, or registry)
    remove     Remove a dependency
    update     Update dependencies
    test       Run tests
    doc        Generate documentation
    publish    Publish to registry (stub)
    clean      Remove build artifacts
    version    Show version
    help       Show help

Examples:
    sino init --lib math
    sino init --bin myapp
    sino build --shared
    sino add github:user/math@1.0.0
    sino add local:../mylib
    sino test
    sino doc
"""

