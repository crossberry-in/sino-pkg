def cmd_build(args):
    """Build the project."""
    output_type = None
    for a in args:
        if a == "--static":
            output_type = "static"
        elif a == "--shared":
            output_type = "shared"
        elif a == "--native":
            output_type = "native"
        else:
            warn(f"Unknown option: {a}")

    manifest = Manifest.load(MANIFEST_FILE)
    info(f"Building {manifest.name} v{manifest.version}...")
    build_project(manifest, output_type)

def cmd_install(args):
    """Install dependencies from sino.toml."""
    manifest = Manifest.load(MANIFEST_FILE)
    deps = manifest.dependencies
    if not deps:
        info("No dependencies to install.")
        return

    info(f"Installing {len(deps)} dependencies...")

    lock = load_lock() or {"packages": {}}
    lock_packages = lock.get("packages", {})

    deps_dir = Path("sino_modules")
    deps_dir.mkdir(exist_ok=True)

    for dep_name, version_req in deps.items():
        step(f"Resolving {dep_name} ({version_req})...")
        try:
            version, source_path = resolve_dependency(dep_name, version_req)
            ok(f"{dep_name} -> v{version} ({source_path})")

            link_path = deps_dir / dep_name.replace(":", "_").replace("/", "_")
            if link_path.exists() or link_path.is_symlink():
                link_path.unlink()
            os.symlink(source_path, link_path)

            lock_packages[dep_name] = {
                "version": str(version),
                "source": str(source_path),
                "resolved_at": datetime.now().astimezone().isoformat(),
            }
        except Exception as e:
            error(f"Failed to resolve {dep_name}: {e}")

    lock["packages"] = lock_packages
    save_lock(lock)
    ok(f"Installed {len(lock_packages)} dependencies. Lock file: {LOCK_FILE}")

def cmd_add(args):
    """Add a dependency."""
    if not args:
        die("Usage: sino add <source> [version]\n"
            "  sino add github:owner/repo\n"
            "  sino add github:owner/repo@1.2.0\n"
            "  sino add local:../mylib\n"
            "  sino add mylib 1.0.0")

    source = args[0]
    version = args[1] if len(args) > 1 else "*"

    manifest = Manifest.load(MANIFEST_FILE)

    if source.startswith("github:"):
        parts = source[len("github:"):]
        if "@" in parts:
            repo, _, tag = parts.partition("@")
            dep_key = f"github:{repo}"
            version = tag
        else:
            dep_key = source
        manifest.dependencies[dep_key] = version
    elif source.startswith("local:"):
        manifest.dependencies[source] = version
    else:
        manifest.dependencies[source] = version

    manifest.save(MANIFEST_FILE)
    ok(f"Added dependency: {source} ({version})")
    info("Run 'sino install' to install it.")

def cmd_remove(args):
    """Remove a dependency."""
    if not args:
        die("Usage: sino remove <name>")

    name = args[0]
    manifest = Manifest.load(MANIFEST_FILE)

    if name in manifest.dependencies:
        del manifest.dependencies[name]
        manifest.save(MANIFEST_FILE)
        ok(f"Removed dependency: {name}")
    else:
        die(f"Dependency '{name}' not found in {MANIFEST_FILE}")

    deps_dir = Path("sino_modules")
    link = deps_dir / name.replace(":", "_").replace("/", "_")
    if link.is_symlink() or link.exists():
        link.unlink()

def cmd_update(args):
    """Update dependencies."""
    manifest = Manifest.load(MANIFEST_FILE)
    if args:
        info(f"Updating: {', '.join(args)}")
    else:
        info("Updating all dependencies...")

    lock = load_lock()
    if lock:
        for pkg in lock.get("packages", {}):
            link = Path("sino_modules") / pkg.replace(":", "_").replace("/", "_")
            if link.exists():
                shutil.rmtree(link)

    Path(LOCK_FILE).unlink(missing_ok=True)
    cmd_install([])

def cmd_test(args):
    """Run tests."""
    manifest = Manifest.load(MANIFEST_FILE)
    tests_dir = Path("tests")
    if not tests_dir.exists():
        info("No tests directory found.")
        return

    sino_bin = shutil.which("sino") or "sino"
    test_files = list(tests_dir.glob("*.si"))
    if not test_files:
        info("No test files (*.si) found in tests/")
        return

    info(f"Running {len(test_files)} test files...")
    failures = 0
    for tf in test_files:
        step(f"Running {tf.name}...")
        result = subprocess.run([sino_bin, str(tf)], capture_output=True, text=True)
        if result.stdout:
            print(result.stdout, end="")
        if result.returncode != 0:
            failures += 1
            if result.stderr:
                print(result.stderr, end="", file=sys.stderr)

    if failures == 0:
        ok(f"All {len(test_files)} test files passed.")
    else:
        die(f"{failures}/{len(test_files)} test files failed.")

def cmd_doc(args):
    """Generate documentation from source files."""
    manifest = Manifest.load(MANIFEST_FILE)
    src_dir = Path("src")
    if not src_dir.exists():
        die("No src/ directory found.")

    doc_dir = Path("docs")
    doc_dir.mkdir(exist_ok=True)

    docs = []
    for si in src_dir.glob("*.si"):
        info(f"Documenting {si.name}...")
        funcs = extract_functions(si)
        docs.append({"file": si.name, "functions": funcs})

    out = doc_dir / "API.md"
    with open(out, "w") as f:
        f.write(f"# {manifest.name} API\n\n")
        f.write(f"Version: {manifest.version}\n\n")
        f.write(f"Description: {manifest.description}\n\n")
        f.write("---\n\n")
        for doc in docs:
            f.write(f"## {doc['file']}\n\n")
            if not doc["functions"]:
                f.write("_No public functions._\n\n")
            for fn in doc["functions"]:
                f.write(f"### `{fn['name']}({', '.join(fn['params'])})`\n\n")
                if fn["comment"]:
                    f.write(f"{fn['comment']}\n\n")
                f.write("---\n\n")

    ok(f"Documentation generated: {out}")

    vscode_dir = Path(".vscode")
    vscode_dir.mkdir(exist_ok=True)
    lsp_meta = {
        "name": manifest.name,
        "version": manifest.version,
        "files": [str(p) for p in src_dir.glob("*.si")],
    }
    (vscode_dir / "sino-lsp.json").write_text(json.dumps(lsp_meta, indent=2))
    ok(f"VS Code/LSP metadata: {vscode_dir / 'sino-lsp.json'}")

def extract_functions(si_file):
    """Extract public function definitions from a .si file."""
    funcs = []
    lines = si_file.read_text().splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        comment = ""
        while i < len(lines) and lines[i].strip().startswith("#"):
            comment += lines[i].strip().lstrip("#").strip() + " "
            i += 1
        if i >= len(lines):
            break
        line = lines[i].strip()
        m = re.match(r"(?:public\s+)?func\s+(\w+)\s*\(([^)]*)\)", line)
        if m:
            name = m.group(1)
            params = [p.strip() for p in m.group(2).split(",") if p.strip()]
            is_public = line.startswith("public")
            if is_public or True:
                funcs.append({"name": name, "params": params, "comment": comment.strip()})
        i += 1
    return funcs

