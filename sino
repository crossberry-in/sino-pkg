    "version": cmd_version,
    "help": cmd_help,
}

def main():
    if len(sys.argv) < 2:
        cmd_help([])
        sys.exit(0)

    cmd = sys.argv[1]
    args = sys.argv[2:]

    if cmd in ("-v", "--version", "-V"):
        cmd_version([])
        return
    if cmd in ("-h", "--help"):
        cmd_help([])
        return

    if cmd not in COMMANDS:
        die(f"Unknown command: {cmd}\nRun 'sino help' for usage.")

    SINO_HOME.mkdir(parents=True, exist_ok=True)
    CACHE_DIR.mkdir(parents=True, exist_ok=True)

    COMMANDS[cmd](args)

if __name__ == "__main__":
    main()
