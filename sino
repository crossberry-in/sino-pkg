# Build System
# ============================================================================

def detect_compilers():
    """Detect available compilers for each language."""
    compilers = {}
    for lang, names in [("c", ["cc", "gcc", "clang"]),
                        ("cpp", ["c++", "g++", "clang++"]),
                        ("asm", ["cc", "gcc", "clang"]),
                        ("rust", ["rustc"]),
                        ("ar", ["ar"]),
                        ("git", ["git"])]:
        for name in names:
            path = shutil.which(name)
            if path:
                compilers[lang] = path
                break
    return compilers

def compile_c_file(src, obj, include_dirs, compilers, extra_flags=None):
    """Compile a single C source file to an object file."""
    cmd = [compilers["c"], "-c", str(src), "-o", str(obj), "-O2", "-fPIC"]
    for inc in include_dirs:
        cmd.extend(["-I", str(inc)])
    if extra_flags:
        cmd.extend(extra_flags)
    step(f"CC  {src.name}")
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        die(f"C compilation failed for {src}:\n{result.stderr}")

def compile_cpp_file(src, obj, include_dirs, compilers, extra_flags=None):
    """Compile a single C++ source file to an object file."""
    cmd = [compilers["cpp"], "-c", str(src), "-o", str(obj), "-O2", "-fPIC"]
    for inc in include_dirs:
        cmd.extend(["-I", str(inc)])
    if extra_flags:
        cmd.extend(extra_flags)
    step(f"C++ {src.name}")
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        die(f"C++ compilation failed for {src}:\n{result.stderr}")

def compile_asm_file(src, obj, compilers, extra_flags=None):
    """Compile a single assembly source file to an object file."""
    cmd = [compilers["asm"], "-c", str(src), "-o", str(obj)]
    if extra_flags:
        cmd.extend(extra_flags)
    step(f"ASM {src.name}")
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        die(f"Assembly compilation failed for {src}:\n{result.stderr}")

def compile_rust_file(src, output_a, compilers, extra_flags=None):
    """Compile a Rust source file to a static library."""
    cmd = [compilers["rust"], "--crate-type", "staticlib", "-O",
           str(src), "-o", str(output_a)]
    if extra_flags:
        cmd.extend(extra_flags)
    step(f"RUST {src.name}")
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        die(f"Rust compilation failed for {src}:\n{result.stderr}")

def create_static_library(objs, output, compilers):
    """Archive object files into a static library (.a)."""
    cmd = [compilers["ar"], "rcs", str(output)] + [str(o) for o in objs]
    step(f"AR  {output.name}")
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        die(f"ar failed: {result.stderr}")

def create_shared_library(objs, output, compilers, extra_libs=None):
    """Link object files into a shared library (.so/.dylib/.dll)."""
    if SYSTEM == "windows":
        cmd = [compilers["c"], "-shared", "-o", str(output)]
    else:
        cmd = [compilers["c"], "-shared", "-o", str(output)]
    cmd.extend(str(o) for o in objs)
    if extra_libs:
        cmd.extend(extra_libs)
    step(f"LINK {output.name}")
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        die(f"Link failed: {result.stderr}")

def create_native_library(si_files, manifest, output):
    """Create a native Sino library (.silib) — a zip archive of .si files + manifest."""
    step(f"PACK {output.name}")
    with zipfile.ZipFile(output, "w", zipfile.ZIP_DEFLATED) as zf:
        for si in si_files:
            zf.write(si, si.relative_to(Path("src")))
        zf.writestr(MANIFEST_FILE, dump_toml(manifest.data))

def build_project(manifest, output_type=None):
    """Build the project according to its manifest."""
    compilers = detect_compilers()
    build_cfg = manifest.build_config()
    out_type = output_type or manifest.output_type or "static"

    build_dir = Path(BUILD_DIR)
    dist_dir = Path(DIST_DIR)
    build_dir.mkdir(exist_ok=True)
    dist_dir.mkdir(exist_ok=True)

    # Clean stale object files to prevent multiple-definition errors when
    # switching between static/shared/native builds.
    for old_obj in build_dir.glob("*.o"):
        old_obj.unlink()
    for old_a in build_dir.glob("*.a"):
        old_a.unlink()

    src_dir = Path("src")
    native_dir = Path("native")
    include_dir = Path("include")
    include_dirs = [include_dir] if include_dir.exists() else []
    include_dirs.append(native_dir)

    si_files = list(src_dir.glob("*.si")) if src_dir.exists() else []

    obj_files = []

    if build_cfg["c"] and native_dir.exists():
        for c_file in native_dir.glob("*.c"):
            # Use full filename stem to avoid collisions with .cpp files of same name
            obj = build_dir / (c_file.stem + "_c.o")
            compile_c_file(c_file, obj, include_dirs, compilers)
            obj_files.append(obj)

    if build_cfg["cpp"] and native_dir.exists():
        for cpp_file in native_dir.glob("*.cpp"):
            obj = build_dir / (cpp_file.stem + "_cpp.o")
            compile_cpp_file(cpp_file, obj, include_dirs, compilers)
            obj_files.append(obj)

    if build_cfg["assembly"] and native_dir.exists():
        for asm_file in native_dir.glob("*.S"):
            obj = build_dir / (asm_file.stem + "_asm.o")
            compile_asm_file(asm_file, obj, compilers)
            obj_files.append(obj)

    rust_libs = []
    if build_cfg["rust"] and native_dir.exists():
        for rs_file in native_dir.glob("*.rs"):
            rust_a = build_dir / (rs_file.stem + ".a")
            compile_rust_file(rs_file, rust_a, compilers)
            rust_libs.append(rust_a)

    lib_name = manifest.name
    dist_path = None

    if out_type == "static":
        out_file = dist_dir / f"{STATIC_LIB_PREFIX}{lib_name}{STATIC_LIB_EXT}"
        all_objs = obj_files + rust_libs
        if all_objs:
            create_static_library(all_objs, out_file, compilers)
        dist_path = out_file
        ok(f"Built static library: {out_file}")
    elif out_type == "shared":
        out_file = dist_dir / f"{SHARED_LIB_PREFIX}{lib_name}{SHARED_LIB_EXT}"
        all_objs = obj_files + rust_libs
        if all_objs:
            create_shared_library(all_objs, out_file, compilers)
        dist_path = out_file
        ok(f"Built shared library: {out_file}")
    elif out_type == "native":
        out_file = dist_dir / f"{lib_name}{NATIVE_LIB_EXT}"
        if si_files:
            create_native_library(si_files, manifest, out_file)
        dist_path = out_file
        ok(f"Built native library: {out_file}")
    else:
        die(f"Unknown output type: {out_type}. Use static, shared, or native.")

    if si_files and out_type in ("static", "shared"):
        native_pkg = dist_dir / f"{lib_name}{NATIVE_LIB_EXT}"
        create_native_library(si_files, manifest, native_pkg)
        ok(f"Also built native package: {native_pkg}")

    return dist_path

