def cmd_init(args):
    """Initialize a new Sino project."""
    project_type = "lib"
    name = None
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--lib", "--library"):
            project_type = "lib"
        elif a in ("--bin", "--binary", "--app"):
            project_type = "bin"
        elif a.startswith("--"):
            warn(f"Unknown option: {a}")
        else:
            name = a
        i += 1

    if not name:
        name = Path.cwd().name
        if name in ("src", "build", "dist", ""):
            die("Please provide a project name: sino init --lib mylib")
        info(f"Using current directory name: {name}")

    project_dir = Path(name) if name != Path.cwd().name else Path(".")
    if project_dir != Path("."):
        project_dir.mkdir(exist_ok=True)

    if project_type == "lib":
        _init_library(project_dir, name)
    else:
        _init_binary(project_dir, name)

    ok(f"Initialized {'library' if project_type == 'lib' else 'binary'} project: {name}")
    info("Next steps:")
    info(f"  cd {name}")
    info("  sino build")
    info("  sino test")

def _init_library(project_dir, name):
    """Create a library project from template."""
    src_dir = project_dir / "src"
    native_dir = project_dir / "native"
    include_dir = project_dir / "include"
    tests_dir = project_dir / "tests"
    examples_dir = project_dir / "examples"

    for d in [src_dir, native_dir, include_dir, tests_dir, examples_dir]:
        d.mkdir(parents=True, exist_ok=True)

    (src_dir / f"{name}.si").write_text(f'''# {name} library

public func add(a, b):
    return a + b
end

public func multiply(a, b):
    return a * b
end
''')

    (src_dir / "vector.si").write_text('''# Vector operations (sub-module)

public func dot(v1, v2):
    var sum = 0
    for var i = 0; i < len(v1); i = i + 1:
        sum = sum + v1[i] * v2[i]
    end
    return sum
end
''')

    (native_dir / f"{name}.c").write_text(f'''/* {name} native C functions */

#ifdef __cplusplus
extern "C" {{
#endif

int c_add(int a, int b) {{
    return a + b;
}}

int c_multiply(int a, int b) {{
    return a * b;
}}

#ifdef __cplusplus
}}
#endif
''')

